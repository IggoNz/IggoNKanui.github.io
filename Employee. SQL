--Write a query to fetch the EmpFname from the EmployeeInfo table in the upper case and use the ALIAS name as EmpName.
SELECT UPPER (EmpFname) AS EmpName
FROM [dbo].['Employee Info$']

-- Same query but in lower case 
SELECT LOWER (EmpFname) AS lower_name
FROM [dbo].['Employee Info$']
WHERE EmpFname IS NOT NULL

 --Same query but DISTINCT UPPERCASE 
SELECT DISTINCT (EmpFname) AS Distinct_name
FROM [dbo].['Employee Info$']
WHERE EmpFname IS NOT NULL

--Write a query to fetch the number of employees working in the department ‘HR’.
SELECT COUNT (*) AS HR_EMPLOYEES
FROM [dbo].['Employee Info$']
WHERE DEPARTMENT = 'HR'

-- grouping by department
SELECT COUNT(*) 
FROM [dbo].['Employee Info$']
GROUP BY DEPARTMENT
